{
  "name": "mensajeriafur",
  "version": "1.0.15",
  "description": "MensajeríaFur - Todas tus apps de mensajería en un solo lugar",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:mac": "electron-builder --mac",
    "build:mac:all": "electron-builder --mac dmg zip --x64 --arm64",
    "build:dmg": "electron-builder --mac dmg",
    "build:zip": "electron-builder --mac zip",
    "build:linux": "electron-builder --linux",
    "build:linux:all": "electron-builder --linux deb --x64 --arm64",
    "build:deb": "electron-builder --linux deb",
    "build:win": "electron-builder --win",
    "build:win:x64": "electron-builder --win nsis portable --x64"
  },
  "author": {
    "name": "PedroGomez",
    "email": "pedrogvas@gmail.com"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.mensajeriafur.app",
    "productName": "MensajeriaFur",
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "icono.png",
      "identity": "Developer ID Application",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "MensajeriaFur necesita acceso a la camara para videollamadas en los servicios compatibles.",
        "NSMicrophoneUsageDescription": "MensajeriaFur necesita acceso al microfono para llamadas y videollamadas en los servicios compatibles.",
        "NSScreenCaptureDescription": "MensajeriaFur necesita acceso para compartir pantalla en los servicios compatibles.",
        "NSAppSleepDisabled": true
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Network;InstantMessaging;Chat;",
      "icon": "build/icons",
      "vendor": "PedroGomez",
      "synopsis": "Todas tus apps de mensajería en un solo lugar",
      "target": [
        "deb",
        "AppImage"
      ],
      "desktop": {
        "Name": "MensajeríaFur",
        "GenericName": "Centro de Mensajería",
        "Comment": "Todas tus apps de mensajería en un solo lugar",
        "StartupWMClass": "MensajeriaFur",
        "Keywords": "mensajeria;whatsapp;telegram;slack;discord;teams;chat;"
      },
      "extraResources": [
        {
          "from": "linux/apparmor-profile",
          "to": "../apparmor-profile"
        }
      ]
    },
    "deb": {
  "license": "Apache-2.0",
  "homepage": "https://github.com/furthurr/mensajeriaFur",
      "priority": "optional",
      "section": "net",
      "afterInstall": "scripts/linux-after-install.sh",
      "afterRemove": "scripts/linux-after-remove.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64",
        "libdrm2",
        "libxkbcommon0",
        "libxrandr2",
        "libxcomposite1",
        "libxdamage1",
        "libxfixes3",
        "libcups2"
      ]
    },
    "win": {
      "icon": "icono.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker",
      "publisherName": "PedroGomez"
    },
    "nsis": {
      "artifactName": "MensajeriaFur-windows-setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "packElevateHelper": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MensajeriaFur",
      "unicode": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "MensajeriaFur-windows-portable.${ext}"
    },
    "afterSign": "scripts/notarize.js",
    "publish": [
      {
        "provider": "github",
        "owner": "furthurr",
        "repo": "mensajeriaFur"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icons/**/*",
      "icono.png",
      "icono.ico",
      "mensajeriaFur_fondo.png",
      "pedro.png"
    ]
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3"
  }
}
